---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, themeVars, shaderColors } from '../../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const cats = ['All', 'Product', 'Brand & events', 'Creative code'] as const;
---
<Base title="Work" current="work" description="Six projects, each designed and built by Aravind Nandakumar: products, fest identities and creative code.">
  <section class="head wrap grid">
    <h1 class="voice h" data-split data-intro>Work</h1>
    <p class="intro" data-lines>Every project here was designed and built by me, from the first sketch to the deployed site. Each one has its own look, so each page takes on its colours.</p>
    <div class="filters" role="group" aria-label="Filter by kind" data-reveal style="--i:2">
      {cats.map((c, i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c}>{c} <span class="n">{c === 'All' ? work.length : work.filter((w) => w.data.category === c).length}</span></button>)}
    </div>
  </section>

  <ul class="tiles wrap" role="list">
    {work.map((w, i) => (
      <li class:list={['tile', i % 4 === 0 || i % 4 === 3 ? 'wide' : 'narrow']} data-cat={w.data.category} data-reveal style={`--i:${i % 2}`}>
        <a href={u(`work/${w.id}/`)} class="tile-link" data-follow="Open">
          <span class="panel" style={themeVars(w.data.theme)}>
            <span class="shader" data-shader={w.data.shader} data-shader-hover data-colors={shaderColors(w.data.theme)}></span>
            <img class="over" src={u(w.data.cover)} alt={w.data.coverAlt} width="1440" height="900" loading={i < 2 ? 'eager' : 'lazy'} />
          </span>
          <span class="cap">
            <span class="t voice">{w.data.title}</span>
            <span class="s">{w.data.line}</span>
            <span class="meta">{w.data.category} · {w.data.does.join(' + ')} · {w.data.year}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .head { padding-top: 160px; padding-bottom: 72px; align-items: end; row-gap: 32px; }
  .h { grid-column: 1 / 7; font-size: var(--step-display); margin-left: -.05em; }
  .intro { grid-column: 8 / 13; font-size: 19px; }
  .filters { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font: 500 15px "Archivo", sans-serif; padding: 10px 16px; border: 0; background: var(--surface); color: var(--ink); cursor: pointer; transition: background-color .25s var(--ease-s), color .25s var(--ease-s), translate .25s var(--ease-s); }
  .chip:hover { translate: 0 -2px; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--ground); }
  .chip .n { opacity: .6; margin-left: 4px; font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) { .h, .intro { grid-column: 1 / -1; } }

  .tiles { list-style: none; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 96px var(--g); padding-bottom: 40px; }
  .tile.wide { grid-column: span 7; }
  .tile.narrow { grid-column: span 5; }
  .tile[hidden] { display: none; }
  @media (max-width: 800px) { .tiles { grid-template-columns: minmax(0, 1fr); gap: 64px; } .tiles .tile { grid-column: 1 / -1; } }
  .tile-link { display: block; text-decoration: none; }
  .panel { display: block; position: relative; background: var(--ground); overflow: hidden; padding: 7% 7% 0; transition: padding .6s var(--ease); }
  .panel img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .tile.narrow .panel { padding: 12% 12% 0; }
  .tile-link:hover .panel, .tile-link:focus-visible .panel { padding: 4% 4% 0; }
  .tile, .tile-link, .cap { min-width: 0; }
  .cap { display: grid; gap: 6px; margin-top: 18px; }
  .t { font-size: clamp(30px, 3.2vw, 52px); }
  .s { font-size: 19px; line-height: 1.3; }
</style>

<script>
  import { onPage } from '../../scripts/page';
  onPage(() => {
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const tiles = [...document.querySelectorAll<HTMLElement>('.tile')];
    for (const chip of chips) chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      tiles.forEach((t) => { t.hidden = !(f === 'All' || t.dataset.cat === f); });
    });
  });
</script>
